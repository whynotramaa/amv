{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Harness",
  "version": "4.0.0",
  "identifier": "local.harness.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run prepare:model && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "overlay",
        "title": "Harness",
        "width": 520,
        "height": 600,
        "minWidth": 420,
        "minHeight": 360,
        "maxWidth": 720,
        "maxHeight": 900,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "contentProtected": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' asset: http://asset.localhost; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": { "models/parakeet/": "models/parakeet/", "models/manifest.json": "models/manifest.json", "models/LICENSE": "models/LICENSE" },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "offlineInstaller", "silent": true },
      "nsis": { "installMode": "currentUser", "displayLanguageSelector": false }
    }
  }
}
